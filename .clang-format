# bbt 三仓统一代码风格：函数定义大括号独占下一行，其余结构大括号同行；120 列；4 空格缩进。
# 工具：clang-format 23.1.3（CI 与本地固定同一版本，见 docs/conventions.md §9）。
# 第三方代码（bbt/coroutine/utils/lockfree）由 .clang-format-ignore 排除。
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
ColumnLimit: 120
# 函数（含构造/析构/类内成员定义）左大括号独占下一行；if/for/while/switch/类/struct/enum/namespace/try/catch/lambda 的大括号保持同行。
# 使用 BreakBeforeBraces: Custom 时其余 BraceWrapping 项默认为 false（不换行），只按需显式打开。
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  SplitEmptyFunction: true
NamespaceIndentation: None
AccessModifierOffset: -4
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left
BinPackArguments: true
BinPackParameters: true
BreakBeforeBinaryOperators: NonAssignment
# 关掉短函数折行，否则空函数体/单语句函数体会被并回函数签名行，抵消上面的函数大括号换行。
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline
# 手工声明列不能精确复现；不启用整组最长类型对齐。
AlignConsecutiveDeclarations: false
MaxEmptyLinesToKeep: 1
SortIncludes: Never
SortUsingDeclarations: Never
ReflowComments: false
FixNamespaceComments: false
InsertBraces: false
SkipMacroDefinitionBody: true
# 字符串属于代码：超长也不自动拆成相邻字面量，避免日志/错误消息无法整句 grep。
BreakStringLiterals: false
