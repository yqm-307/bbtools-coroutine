# bbt 代码风格：短小类内函数允许单行，其余函数定义大括号独占下一行；120 列；4 空格缩进。
# 工具：clang-format 23.1.3（CI 与本地固定同一版本，见 docs/conventions.md §9）。
# 第三方代码（bbt/coroutine/utils/lockfree）由 .clang-format-ignore 排除。
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
ColumnLimit: 120
# 除短小类内函数外，函数左大括号独占下一行；if/for/while/switch/类/struct/enum/namespace/try/catch/lambda 的大括号保持同行。
# 使用 BreakBeforeBraces: Custom 时其余 BraceWrapping 项默认为 false（不换行），只按需显式打开。
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  SplitEmptyFunction: true
NamespaceIndentation: None
AccessModifierOffset: -4
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left
BinPackArguments: true
BinPackParameters: true
BreakBeforeBinaryOperators: NonAssignment
# 空函数、简单访问器和短小类内函数保留单行；非平凡实现仍按正常规则换行。
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline
# 手工声明列不能精确复现；不启用整组最长类型对齐。
AlignConsecutiveDeclarations: false
MaxEmptyLinesToKeep: 1
SortIncludes: Never
SortUsingDeclarations: Never
ReflowComments: false
FixNamespaceComments: false
InsertBraces: false
SkipMacroDefinitionBody: true
# 字符串属于代码：超长也不自动拆成相邻字面量，避免日志/错误消息无法整句 grep。
BreakStringLiterals: false
