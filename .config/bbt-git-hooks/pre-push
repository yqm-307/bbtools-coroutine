#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
pub_root="$repo_root/third-party/bbtools-pub"
stage="$pub_root/tools/git-hooks/stages/push/main.py"

if [ ! -f "$stage" ]; then
    printf 'bbt-git-hooks: missing pub push stage: %s\n' "$stage" >&2
    exit 2
fi

exec python3 -I "$stage" "$@"
