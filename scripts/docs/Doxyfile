# 公开头文件 API 文档。入口：scripts/docs/build_docs.sh（本地与 CI 共用，从仓库根运行）。
# 一次解析同时产出 HTML（给人看）与 XML（export_ai_docs.py 转成给 AI 看的分层 Markdown）。
# 路径均相对仓库根；输出目录、版本、主题由 build_docs.sh 通过环境变量传入。

PROJECT_NAME           = "$(DOCS_PROJECT)"
PROJECT_NUMBER         = "$(DOCS_VERSION)"
OUTPUT_DIRECTORY       = $(DOCS_OUT)

# 只导出公开头文件；detail/ 与无锁容器、debug 是实现细节，不进文档。
INPUT                  = bbt/coroutine bbt/pollevent
STRIP_FROM_PATH        = .
FILE_PATTERNS          = *.hpp *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/* */utils/lockfree/* */debug/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

GENERATE_XML           = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

HAVE_DOT               = YES
UML_LOOK               = YES
CALL_GRAPH             = NO

# 主题（Doxygen Awesome）由 build_docs.sh 传入；未提供时回落到 Doxygen 默认样式。
HTML_EXTRA_STYLESHEET  = $(DOXYGEN_AWESOME_CSS)
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = LIGHT

# 缺注释只告警；是否阻断由 build_docs.sh 的 DOCS_WERROR 决定。
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = $(DOCS_OUT)/warnings.log
QUIET                  = YES
